{
  "name": "midi-sketch-bach-homepage",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vitepress dev",
    "build": "node scripts/check-rule-count.mjs && vitepress build",
    "preview": "vitepress preview",
    "check:rules": "node scripts/check-rule-count.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check src .vitepress scripts",
    "lint:fix": "biome check --write src .vitepress scripts",
    "format": "biome format --write src .vitepress scripts",
    "copy:wasm": "./scripts/copy-wasm.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.4.1",
    "markdown-it": "^14.3.0",
    "markdown-it-cjk-friendly": "^3.0.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "smplr": "^1.0.0",
    "vexflow": "^5.0.0"
  }
}
